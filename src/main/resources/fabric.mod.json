{
	"schemaVersion": 1,
	"id": "camrotate",
	"version": "1.0.9",
	"name": "Camrotate",
	"description": "Rotate your body to where your camera is looking! ( helpful for first person mods )",
	"authors": [
		"kitkat_m"
	],
	"contact": {
		"homepage": "https://modrinth.com/user/kitkat_m",
		"sources": "https://github.com/kitkat-gh/camrotatemc"
	},
	"license": "MIT",
	"icon": "assets/camrotate/icon.png",
